PORT=4000
CORS_ORIGIN=http://localhost:5173
# URL pública del API (MercadoPago necesita alcanzar el webhook)
PUBLIC_API_URL=https://api.tu-dominio.com
PUBLIC_APP_URL=https://app.tu-dominio.com
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=admincountrys
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES=12h
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tu-dominio.com
# Clave secreta de webhooks de la app MercadoPago (validación x-signature)
MP_WEBHOOK_SECRET=
# Credenciales de la app MercadoPago (para OAuth por tenant)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Zona horaria del complejo (todas las fechas se guardan en hora local)
TZ=America/Argentina/Buenos_Aires
# Rondas: precisión GPS máxima aceptada (m), radio por defecto de un punto nuevo (m) y antigüedad máxima de la lectura (s)
GPS_MAX_ACCURACY_M=50
CHECKPOINT_DEFAULT_RADIUS_M=30
GPS_MAX_FIX_AGE_S=120
