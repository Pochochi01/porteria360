# ============================================================
#  Producción · porteria360.net (Hostinger VPS KVM 2)
#  Copiar a backend/.env en el servidor y completar los valores marcados con  <-- COMPLETAR
#  Nunca subir el .env real a git.
#  Si un valor tiene # o espacios, ponerlo entre comillas:  DB_PASSWORD="abc#123"
# ============================================================

NODE_ENV=production

# El backend escucha solo en localhost: el público entra por Nginx (80) → 127.0.0.1:5007
# (debe coincidir con el upstream de deploy/nginx/porteria360.net.conf)
HOST=127.0.0.1
PORT=5007

# Un solo dominio: Express sirve la API (/api/...) y la PWA. Por eso API y APP son la MISMA URL.
#  - PUBLIC_API_URL: base para MercadoPago (webhook y vuelta del OAuth). Sin "/api" al final: el código lo agrega.
#  - PUBLIC_APP_URL: a dónde vuelve el usuario después de pagar o de vincular MercadoPago.
# Mientras no haya certificado SSL usar http://; al instalarlo (certbot --nginx) cambiar a https://
PUBLIC_API_URL=http://porteria360.net
PUBLIC_APP_URL=http://porteria360.net
# Orígenes permitidos (CORS). www redirige al dominio principal, pero se deja por las dudas.
CORS_ORIGIN=http://porteria360.net,http://www.porteria360.net,https://porteria360.net,https://www.porteria360.net

# MySQL en el mismo VPS. Usar un usuario propio, NO root:
#   CREATE DATABASE porteria360 CHARACTER SET utf8mb4;
#   CREATE USER 'porteria360'@'localhost' IDENTIFIED BY 'una-clave-larga';
#   GRANT ALL PRIVILEGES ON porteria360.* TO 'porteria360'@'localhost';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=porteria360
DB_PASSWORD=                     # <-- COMPLETAR
DB_NAME=porteria360

# Generar en el servidor:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=                      # <-- COMPLETAR (distinto al de desarrollo)
JWT_EXPIRES=12h

# Notificaciones push (emergencias, visitas, rondas). Generar con:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=                # <-- COMPLETAR
VAPID_PRIVATE_KEY=               # <-- COMPLETAR
VAPID_SUBJECT=mailto:admin@porteria360.net

# MercadoPago (cobro de reservas y expensas). Datos de tu aplicación en https://www.mercadopago.com.ar/developers/panel
#  En la aplicación de MercadoPago configurar:
#   - URL de redireccionamiento (OAuth): https://porteria360.net/api/pagos/oauth/callback
#   - Webhooks (evento "Pagos"):        https://porteria360.net/api/pagos/webhook
MP_CLIENT_ID=                    # <-- COMPLETAR
MP_CLIENT_SECRET=                # <-- COMPLETAR
# Clave secreta que muestra MercadoPago al configurar los Webhooks (valida la firma x-signature)
MP_WEBHOOK_SECRET=               # <-- COMPLETAR

# Zona horaria del complejo (todas las fechas se guardan en hora local)
TZ=America/Argentina/Buenos_Aires

# Opcional: carpeta de la PWA compilada. Por defecto <proyecto>/frontend/dist (no hace falta definirla).
# Si es relativa se resuelve desde backend/, nunca desde el directorio de trabajo de PM2.
# FRONTEND_DIST=../frontend/dist
# Rondas: precisión GPS máxima aceptada (m), radio por defecto de un punto nuevo (m) y antigüedad máxima de la lectura (s)
GPS_MAX_ACCURACY_M=50
CHECKPOINT_DEFAULT_RADIUS_M=30
GPS_MAX_FIX_AGE_S=120
